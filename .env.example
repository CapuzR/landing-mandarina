# Mandarina — landing (sitio estático, Next.js export)
# Copia a `.env.local` y completa lo que quieras sobreescribir. TODO es opcional:
# si no defines una variable, se usa el valor por defecto (los que ya estaban en el
# código), así que el build funciona sin .env. Al ser un export estático, los valores
# se "hornean" en el bundle en `npm run build` — por eso todas son NEXT_PUBLIC_.

# URL canónica del sitio (metadata/OG, sitemap.xml, robots.txt). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://usamandarina.com

# URL del Worker (Resend) que envía los correos del sitio: el reporte de la
# calculadora Y el lead del formulario "Empresa fundadora" (ver landing/worker/).
# - Calculadora: si queda vacío o con el placeholder, muestra los resultados igual,
#   solo NO envía el correo (WORKER_CONFIGURADO=false).
# - Formulario "Empresa fundadora": sin esta URL, el formulario no puede enviar.
NEXT_PUBLIC_FORMS_WORKER_URL=

# Enlaces de contacto usados por la calculadora (CTAs).
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/584143201028
NEXT_PUBLIC_AGENDA_URL=https://calendar.app.google/UEFQFLVuHaeTod357
